# Environment: development | production | test
NODE_ENV=development
PORT=3000

# Application version (optional, defaults to package.json)
VERSION=

# Logging level: silent|error|warn|info|debug|trace
LOG_LEVEL=info

# Comma-separated list of allowed origins for CORS in production
# Example: https://app.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=

# =============================================================================
# Authentication
# =============================================================================

BETTER_AUTH_SECRET=your-secret-key-here

# Phone auth and OTP configuration
PHONE_OTP_REQUIRED=true
OTP_CODE_LENGTH=6
OTP_TTL_SECONDS=300

# Feature flags
LOGIN_ENABLED=true
REGISTER_ENABLED=true
FORGOT_PASSWORD_ENABLED=true
OTP_ENABLED=true

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# =============================================================================
# Database (MySQL)
# =============================================================================

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=app
MYSQL_CONNECTION_LIMIT=10

# =============================================================================
# Rate Limiting & Security
# =============================================================================

# Global API rate limit (requests per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Auth endpoints rate limit (stricter)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=5

# IP Whitelist (comma-separated IPs for login, dashboard, call center)
# Example: 192.168.1.100,10.0.0.50
WHITELISTED_IPS=

# =============================================================================
# File Upload
# =============================================================================

# Upload directory (relative to backend root)
UPLOAD_DIR=./uploads

# Max file size in MB
MAX_FILE_SIZE=50

# Chunk size in bytes (default 1MB)
CHUNK_SIZE=1048576

# Allowed MIME types (comma-separated)
# Example: image/*,application/pdf,video/*,audio/*
ALLOWED_MIME_TYPES=image/*,application/pdf,video/*,audio/*

# =============================================================================
# Chapa Payment Gateway
# =============================================================================

# Get your keys from https://dashboard.chapa.co
# Test keys start with CHAPUBK_TEST- and CHASECK_TEST-
# Production keys start with CHAPUBK- and CHASECK-
CHAPA_PUBLIC_KEY=
CHAPA_SECRET_KEY=
CHAPA_BASE_URL=https://api.chapa.co/v1

# =============================================================================
# JWT Configuration
# =============================================================================

JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=http://localhost:3000
JWT_AUDIENCE=my-track-mobile

# =============================================================================
# Firebase Cloud Messaging (Push Notifications)
# =============================================================================

# Path to Firebase service account JSON file
# Download from Firebase Console > Project Settings > Service Accounts
# Example: /path/to/serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=

# =============================================================================
# AfroSMS (SMS Gateway)
# =============================================================================

# Get your API key from https://www.afrosms.com
# Sender ID is the name that appears as the sender (max 11 characters)
AFROSMS_API_KEY=
AFROSMS_SENDER_ID=MyTrack
AFROSMS_BASE_URL=https://api.afrosms.com/api/send
