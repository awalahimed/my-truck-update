# Root level gitignore for My-Track project

# Environment files (all levels)
.env
.env.local
.env.development
.env.test
.env.production
**/.env
**/.env.local
**/.env.development
**/.env.test
**/.env.production

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
**/dist/
**/build/

# Logs
*.log
logs/
**/logs/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
*.tmp
*.temp
tmp/
temp/

# Database files
*.db
*.sqlite
*.sqlite3

# Certificates and keys
*.pem
*.key
*.crt
*.csr
*.p12
*.p8
*.jks
*.keystore

# cPanel deployment keys
cpanel_deploy_key
cpanel_deploy_key.pub

# Firebase
firebase-service-account.json
serviceAccountKey.json
google-services.json
GoogleService-Info.plist

# Upload directories
uploads/
**/uploads/

# Coverage reports
coverage/
**/coverage/

# Package manager lock files (keep package-lock.json for Docker builds)
yarn.lock
pnpm-lock.yaml

# TypeScript
*.tsbuildinfo

# Local development
*.local

# -------------------------
# Re-include specific files that are otherwise ignored
# (unignore parent directories first, then the exact files)

# Allow VS Code launch config
!.vscode/
!.vscode/launch.json

# Re-include dist and selected subfolders
!dist/
!dist/commands/
!dist/controllers/
!dist/controllers/admin/
!dist/database/
!dist/database/schema/
!dist/jobs/
!dist/services/
!dist/utils/

